generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}


model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  avatarUrl    String?
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authSessions AuthSession[]
  workspaceMemberships WorkspaceMember[]
  workspaceInvitationsSent  WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  projectsCreated      Project[]   @relation("ProjectCreator")
  boardsCreated     Board[]  @relation("BoardCreator")

  @@map("users")
}
model AuthSession {
  id               String    @id @default(uuid())
  refreshTokenHash String    @unique
  userId           String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastRefreshedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Workspace{
  id     String     @id @default(uuid())
  name   String    
  slug   String     @unique
  description  String?
  logoUrl      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  members      WorkspaceMember[]
  invitations     WorkspaceInvitation[]
  projects      Project[]

  @@index([deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String                    @id @default(uuid())
  workspaceId String
  email       String
  role        WorkspaceRole             @default(MEMBER)
  status      WorkspaceInvitationStatus @default(PENDING)
  tokenHash   String                    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  declinedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, email])
  @@index([email, status])
  @@index([workspaceId, status]) 
  @@index([expiresAt])
  @@map("workspace_invitations")
}

model Project {
  id          String        @id @default(uuid())
  workspaceId String
  name        String
  key         String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  dueDate     DateTime?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  boards     Board[]


  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdBy User @relation("ProjectCreator",fields: [createdById],references: [id],onDelete: Restrict)

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
  @@index([workspaceId, deletedAt])
  @@index([createdById])
  @@map("projects")
}


model Board {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  position    Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  project Project @relation(fields: [projectId],references: [id],onDelete: Cascade)

  createdBy User @relation("BoardCreator",fields: [createdById],references: [id],onDelete: Restrict)

  @@index([projectId, deletedAt, position])
  @@index([createdById])
  @@map("boards")
}